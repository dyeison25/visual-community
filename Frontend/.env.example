# Configuración pública de TU app web Firebase. No usar credenciales Admin.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Opcionales:
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Desarrollo: /api usa el proxy de Vite. Lanzamiento: URL HTTPS de Cloud Run + /api.
VITE_API_BASE_URL=/api
# Solo desarrollo. bun run dev:emulators configura emuladores sin credenciales.
VITE_USE_FIREBASE_EMULATORS=false

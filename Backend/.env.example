# Servidor. En Render PORT lo proporciona la plataforma.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Proyecto propio. En Render usar las tres variables privadas; sin JSON dentro de Docker.
FIREBASE_PROJECT_ID=
# Render: completar ambas junto a FIREBASE_PROJECT_ID; solo en el servidor.
# FIREBASE_PRIVATE_KEY admite saltos de línea reales o escapados como \n.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Solo para desarrollo local si el archivo no está en Backend/firebase-service-account.json:
GOOGLE_APPLICATION_CREDENTIALS=

# Backend únicamente. El modelo debe estar habilitado en tu cuenta.
GEMINI_API_KEY=
GEMINI_MODEL=
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=visual_community_content
# Solo herramienta de indexación; NO necesaria en el servidor público:
ALGOLIA_ADMIN_API_KEY=

# Opcionales: no cambiar sin verificar el servicio oficial.
MINENERGIA_LAYER_URL=
XM_API_URL=
EXTERNAL_TIMEOUT_MS=12000

# Recordatorios por correo. Permanecen desactivados hasta completar pruebas controladas.
FRONTEND_URL=http://localhost:5173
REMINDER_ENABLED=false
REMINDER_DRY_RUN=true
REMINDER_SEND_MODE=test
REMINDER_TEST_USER_IDS=
REMINDER_INACTIVITY_DAYS=4
REMINDER_MAX_ATTEMPTS=3
REMINDER_BATCH_SIZE=50
# Solo en el backend/Render. Nunca usar prefijo VITE_.
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_TOKEN_SECRET=

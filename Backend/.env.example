# Servidor. En Cloud Run PORT lo proporciona la plataforma.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Proyecto propio. En Cloud Run usar identidad de servicio (ADC), sin JSON privado.
FIREBASE_PROJECT_ID=
# Render: completar ambas junto a FIREBASE_PROJECT_ID; solo en el servidor.
# FIREBASE_PRIVATE_KEY admite saltos de línea reales o escapados como \n.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Solo para desarrollo local si el archivo no está en Backend/firebase-service-account.json:
GOOGLE_APPLICATION_CREDENTIALS=

# Backend únicamente. El modelo debe estar habilitado en tu cuenta.
GEMINI_API_KEY=
GEMINI_MODEL=
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=visual_community_content
# Solo herramienta de indexación; NO necesaria en el servidor público:
ALGOLIA_ADMIN_API_KEY=

# Opcionales: no cambiar sin verificar el servicio oficial.
MINENERGIA_LAYER_URL=
XM_API_URL=
EXTERNAL_TIMEOUT_MS=12000

{
    "name":  "visual-community",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "bun scripts/dev.ts",
                    "dev:emulators":  "bun scripts/dev.ts --emulators",
                    "emulators":  "firebase emulators:start --only auth,firestore --project demo-visual-community",
                    "build":  "bun run --cwd Backend build && bun run --cwd Frontend build && node scripts/check-client-secrets.mjs",
                    "audit:source": "node scripts/audit-source.mjs --exports",
                    "check:secrets": "node scripts/check-client-secrets.mjs",
                    "test:build-ui": "node scripts/verify-ui.mjs",
                    "typecheck":  "bun run --cwd Backend typecheck && bun run --cwd Frontend typecheck && bun run typecheck:tools",
                    "typecheck:tools": "bun Backend/node_modules/typescript/bin/tsc -p tsconfig.tools.json",
                    "test":  "bun test Backend/tests",
                    "test:packaging": "bun test tests/packaging.test.ts",
                    "test:e2e":  "firebase emulators:exec --only auth,firestore --project demo-visual-community \"playwright test\"",
                    "test:rules":  "firebase emulators:exec --only auth,firestore --project demo-visual-community \"bun test tests/firestore.rules.test.ts\"",
                    "test:e2e:running":  "playwright test",
                    "test:production": "playwright test --config playwright.production.config.ts",
                    "test:rules:running":  "bun test tests/firestore.rules.test.ts",
                    "test:notifications": "firebase emulators:exec --only auth,firestore --project demo-visual-community \"bun test tests/notifications.integration.test.ts tests/firestore.rules.test.ts\""
                },
    "devDependencies":  {
                            "@playwright/test":  "^1.58.2",
                            "@firebase/rules-unit-testing":  "^5.0.0",
                            "firebase-tools":  "^15.0.0",
                            "firebase":  "^12.0.0"
                        }
}
